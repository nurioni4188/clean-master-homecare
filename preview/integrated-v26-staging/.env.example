# Public browser configuration ONLY. NEVER use service_role or server secrets here.
VITE_CM_ENV_LABEL=CLEAN_MASTER_STAGING
VITE_CM_STAGING_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_CM_STAGING_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Fail closed by default. Enable only in isolated Staging with synthetic users/data.
VITE_CM_SYNTHETIC_WRITES=OFF
